# Shared C++ checks for cosmin's public projects.
#
# High-signal only. The noisy families (cppcoreguidelines-*, fuchsia-*,
# llvmlibc-*, altera-*) are deliberately absent: on Qt/OpenGL code they produce
# far more noise than signal.
#
# misc-include-cleaner is the one that matters most: it catches headers used but
# not included (e.g. std::clamp without <algorithm>), which today compile only
# because Qt drags them in transitively. That breaks on other toolchains.
Checks: >
  -*,
  bugprone-*,
  modernize-*,
  performance-*,
  misc-include-cleaner,
  misc-unused-parameters,
  misc-unused-using-decls,
  readability-identifier-naming,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -modernize-use-trailing-return-type,
  -modernize-avoid-c-arrays,
  -modernize-use-nodiscard

HeaderFilterRegex: '.*/(src|include)/[^/]+\.(h|hpp)$'
ExcludeHeaderFilterRegex: '.*(moc_|qrc_|ui_|_autogen|_deps).*'
FormatStyle: file
WarningsAsErrors: ''

# --- Naming: Qt/UI cluster (Threading, QtOpenGLQuadPlayers, Mp4DualPlayer,
# --- PBRViewer). Matches the 2100+ existing m_ members across these repos.
CheckOptions:
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: camelBack
  - key: readability-identifier-naming.MethodCase
    value: camelBack
  - key: readability-identifier-naming.VariableCase
    value: camelBack
  - key: readability-identifier-naming.PrivateMemberPrefix
    value: 'm_'
  - key: readability-identifier-naming.ProtectedMemberPrefix
    value: 'm_'
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.GlobalConstantPrefix
    value: 'k'
